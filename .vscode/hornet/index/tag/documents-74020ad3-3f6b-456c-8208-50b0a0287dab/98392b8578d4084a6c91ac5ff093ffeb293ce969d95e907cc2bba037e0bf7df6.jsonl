{"text":"#include <iostream>\nusing namespace std;\n\nint main() {\n    int N, contador, suma;\n    cout << \"Escribe un numero entero positivo: \";\n    cin >> N;\n\n    while (N <= 0) {\n        cout << \"Numero invalido, escribe otro numero: \";\n        cin >> N;\n    }\n\n    contador = 1;\n    suma = 0;\n\n    while (contador <= N) {\n        suma = suma + contador;\n        contador = contador + 1;\n    }\n\n    cout << \"La suma es: \" << suma << endl;\n    return 0;\n}"}
