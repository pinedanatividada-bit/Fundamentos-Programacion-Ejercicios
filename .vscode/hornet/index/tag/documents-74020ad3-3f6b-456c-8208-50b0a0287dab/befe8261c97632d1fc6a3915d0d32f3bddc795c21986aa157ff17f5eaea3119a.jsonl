{"text":"#include <iostream>\nusing namespace std;\n\nint main() {\n    int opcion;\n    float num1, num2, resultado;\n\n    do {\n        cout << \"\\n===== MENU DE OPERACIONES =====\" << endl;\n        cout << \"1. Suma\" << endl;\n        cout << \"2. Resta\" << endl;\n        cout << \"3. Multiplicacion\" << endl;\n        cout << \"4. Division\" << endl;\n        cout << \"5. Salir\" << endl;\n\n        cout << \"\\nSelecciona una opcion: \";\n        cin >> opcion;\n\n        switch (opcion) {\n            case 1:\n                cout << \"Ingresa el primer numero: \";\n                cin >> num1;\n                cout << \"Ingresa el segundo numero: \";\n                cin >> num2;\n                resultado = num1 + num2;\n                cout << \"Resultado de la suma: \" << resultado << endl;\n                break;\n\n            case 2:\n                cout << \"Ingresa el primer numero: \";\n                cin >> num1;\n                cout << \"Ingresa el segundo numero: \";\n                cin >> num2;\n                resultado = num1 - num2;\n                cout << \"Resultado de la resta: \" << resultado << endl;\n                break;\n\n            case 3:\n                cout << \"Ingresa el primer numero: \";\n                cin >> num1;\n                cout << \"Ingresa el segundo numero: \";\n                cin >> num2;\n                resultado = num1 * num2;\n                cout << \"Resultado de la multiplicacion: \" << resultado << endl;\n                break;\n\n            case 4:\n                cout << \"Ingresa el primer numero: \";\n                cin >> num1;\n                cout << \"Ingresa el segundo numero: \";\n                cin >> num2;\n                if (num2 != 0) {\n                    resultado = num1 / num2;\n                    cout << \"Resultado de la division: \" << resultado << endl;\n                } else {\n                    cout << \"Error: No se puede dividir entre cero.\" << endl;\n                }\n                break;\n\n            case 5:\n                cout << \"Gracias por utilizar el programa. Saliendo...\" << endl;\n                break;\n\n            default:\n                cout << \"Opcion no valida. Intenta nuevamente.\" << endl;\n                break;\n        }\n    } while (opcion != 5);\n\n    return 0;\n}"}
